rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the user's churchId from their user document in /users/{userId}
    function getUserChurchId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.church_id;
    }

    // Helper to check if a document's churchId matches the user's churchId
    function belongsToUserChurch(resourceData) {
      return resourceData.church_id == getUserChurchId();
    }

    // Allow read/write for relation-only or user-owned tables that might not store churchId directly
    match /department_members/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /departmentMembers/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /schedule_members/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /scheduleMembers/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /schedule_slots/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /scheduleChats/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /schedule_chats/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /scheduleAttachments/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /schedule_attachments/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /pushTokens/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /push_tokens/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /notifications/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /unavailable_dates/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /unavailableDates/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /password_reset_tokens/{docId} {
      allow read, write: if true;
    }
    match /passwordResetTokens/{docId} {
      allow read, write: if true;
    }
    match /member_invitations/{docId} {
      allow read, write: if true;
    }
    match /invitations/{docId} {
      allow read, write: if true;
    }

    // Default rule for generic collections
    match /{collectionName}/{docId} {
      allow read, update, delete: if isAuthenticated() && belongsToUserChurch(resource.data);
      allow create: if isAuthenticated() && request.resource.data.church_id == getUserChurchId();
    }
    
    // Allow initial registration (creation of church, user, and onboarding)
    match /churches/{churchId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (resource == null || belongsToUserChurch(resource.data));
    }
    
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update, delete: if isAuthenticated() && (userId == request.auth.uid || belongsToUserChurch(resource.data));
    }
    
    match /onboardingProgress/{progressId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (resource == null || belongsToUserChurch(resource.data));
    }
  }
}