rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get the user's churchId from their user document in /users/{userId}
    function getUserChurchId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.churchId;
    }

    // Helper to check if a document's churchId matches the user's churchId
    function belongsToUserChurch(resourceData) {
      return resourceData.churchId == getUserChurchId();
    }

    // Default rule for generic collections
    match /{collectionName}/{docId} {
      allow read, update, delete: if isAuthenticated() && belongsToUserChurch(resource.data);
      allow create: if isAuthenticated() && request.resource.data.churchId == getUserChurchId();
    }
    
    // Allow initial registration (creation of church, user, and onboarding)
    match /churches/{churchId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (resource == null || belongsToUserChurch(resource.data));
    }
    
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read, update, delete: if isAuthenticated() && (userId == request.auth.uid || belongsToUserChurch(resource.data));
    }
    
    match /onboardingProgress/{progressId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated() && (resource == null || belongsToUserChurch(resource.data));
    }
  }
}